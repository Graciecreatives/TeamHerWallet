# PostgreSQL is server-only. Any standard PostgreSQL host can be used.
# Local Docker example after setting POSTGRES_PASSWORD below:
# DATABASE_URL=postgresql://learnpurse:URL_ENCODED_PASSWORD@localhost:5432/learnpurse
# Hosted databases: use your provider URL with sslmode=verify-full.
DATABASE_URL=
# Optional direct/unpooled URL for release migrations.
DATABASE_MIGRATION_URL=
# Only needed for the optional local Docker Compose database.
POSTGRES_PASSWORD=
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_AI_PROVIDER=gemini
NUXT_AI_API_KEY=
NUXT_AI_PROVIDER_OPTIONS=gemini,groq
NUXT_AI_API_KEY=
NUXT_STELLAR_NETWORK=TESTNET
NUXT_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NUXT_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Obtain exact Testnet asset and supported facilitator configuration. Never guess.
NUXT_STELLAR_USDC_CONTRACT_ID=
NUXT_X402_FACILITATOR_URL=
NUXT_X402_FACILITATOR_API_KEY=
NUXT_LEARNPURSE_REGISTRY_CONTRACT_ID=
# Server-only Testnet registrar. Never use a user wallet seed.
NUXT_LEARNPURSE_REGISTRAR_SECRET=

# Cloudflare R2 image Worker (cloudflare/image-worker). Server-only secret.
NUXT_IMAGE_UPLOAD_URL=
NUXT_IMAGE_UPLOAD_SECRET=
# Optional Groq model order, comma-separated.
NUXT_AI_MODEL=
# Cloudflare D1 data API (cloudflare/api-worker). Server-only secret.
NUXT_CLOUD_API_URL=
NUXT_CLOUD_API_SECRET=
